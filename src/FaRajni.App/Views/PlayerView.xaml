<UserControl x:Class="FaRajni.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{StaticResource PlayerBgBrush}" Foreground="White"
             FontFamily="{StaticResource UiFont}" FontSize="14">

    <!-- The video fills the surface. Controls live inside the VideoView, which hosts them in a
         transparent window above the native video (WPF can't draw over it otherwise). -->
    <vlc:VideoView x:Name="VideoView" Background="{StaticResource PlayerBgBrush}">
        <Grid x:Name="Overlay" Background="#01000000" MouseWheel="Overlay_MouseWheel"
              MouseLeftButtonDown="Overlay_MouseDown" TextElement.Foreground="White"
              TextOptions.TextFormattingMode="Display">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ top bar ============ -->
            <Grid x:Name="TopBar" Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid Margin="20,16,20,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnBase}" Width="38" Padding="0" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                            BorderThickness="1" Foreground="White" ToolTip="Back to library (Esc)" Click="Back_Click">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="15"/>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubText" FontSize="12" Foreground="#8CFFFFFF" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="DeleteBtn" Grid.Column="2" Style="{StaticResource BtnBase}" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                            BorderThickness="1" Foreground="{StaticResource DangerTextBrush}" Margin="0,0,8,0" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15"/>
                            <TextBlock Text="Delete" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <Border Background="#1AFFFFFF" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="Del" Style="{StaticResource Mono}" FontSize="10.5" Foreground="#99FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditBtn" Grid.Column="3" Style="{StaticResource BtnBase}" Background="#1FFFFFFF" Foreground="White"
                            FontWeight="Medium" Click="Edit_Click" ToolTip="Cut, GIF, audio (E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="15"/>
                            <TextBlock Text="Edit" Margin="8,0,2,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ============ centre: paused indicator / messages ============ -->
            <Border x:Name="PausedBadge" Grid.Row="1" Width="76" Height="76" CornerRadius="38" Background="#29FFFFFF"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="30" Margin="4,0,0,0"/>
            </Border>
            <Border x:Name="Flash" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Padding="14,7" CornerRadius="12" Background="#CC12141F" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="FlashText" FontSize="13"/>
            </Border>

            <!-- ============ previous / next (sides of the video) ============ -->
            <Button x:Name="PrevBtn" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0"
                    Click="Prev_Click" ToolTip="Previous video (P)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Width="52" Height="52" CornerRadius="26" Background="#8C111320" BorderBrush="#26FFFFFF" BorderThickness="1" Cursor="Hand">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="20" Foreground="White" Margin="0,0,2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#CC1A1D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="NextBtn" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                    Click="Next_Click" ToolTip="Next video (N)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Width="52" Height="52" CornerRadius="26" Background="#8C111320" BorderBrush="#26FFFFFF" BorderThickness="1" Cursor="Hand">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="20" Foreground="White" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#CC1A1D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ============ bottom: controls or editor ============ -->
            <Grid x:Name="BottomArea" Grid.Row="2">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Border x:Name="ControlBar" Margin="24,30,24,22" Padding="16,12" CornerRadius="20"
                        Background="#C7111320" BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <StackPanel>
                        <!-- seek track -->
                        <Grid x:Name="SeekTrack" Height="16" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up" LostMouseCapture="Seek_Lost">
                            <Border Height="4" CornerRadius="2" Background="#2EFFFFFF"/>
                            <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="#6E9BF5" HorizontalAlignment="Left" Width="0"/>
                            <Ellipse x:Name="SeekKnob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobX" X="-7"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <!-- buttons -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="44" Height="44" Margin="0,0,4,0" ToolTip="Play / pause (Space)" Click="PlayPause_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="22" Background="White">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="18" Foreground="#141622"/>
                            </Button>
                            <TextBlock x:Name="TimeText" Grid.Column="1" Style="{StaticResource Mono}" FontSize="12.5" Foreground="#BFFFFFFF"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Text="0:00 / 0:00"/>
                            <Button x:Name="SpeedBtn" Grid.Column="6" Style="{StaticResource BtnBase}" Height="34" MinWidth="48" Padding="10,0"
                                    BorderBrush="#24FFFFFF" BorderThickness="1" Foreground="White" ToolTip="Playback speed" Click="Speed_Click">
                                <TextBlock x:Name="SpeedText" Text="1×" Style="{StaticResource Mono}" FontSize="12"/>
                            </Button>
                            <Button Grid.Column="7" Style="{StaticResource PlayerIconBtn}" ToolTip="Mute (M) · volume ↑ ↓" Click="Mute_Click" Margin="4,0,0,0">
                                <TextBlock x:Name="VolIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="17"/>
                            </Button>
                            <Button Grid.Column="8" Style="{StaticResource PlayerIconBtn}" ToolTip="Full screen (F)" Click="Fullscreen_Click">
                                <TextBlock x:Name="FsIcon" Style="{StaticResource Icon}" Text="&#xE740;" FontSize="16"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="EditorHost" Margin="24,30,24,22" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </vlc:VideoView>
</UserControl>
