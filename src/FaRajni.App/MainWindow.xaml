<Window x:Class="FaRajni.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaRajni" Width="1320" Height="840" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Resources/icon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Root">
        <!-- Night backdrop: soft glows + a faint star field. Static, cached as a bitmap. -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="0.5"/>
            </Grid.CacheMode>
            <Ellipse Width="1100" Height="1100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-460,-520,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#552C3B9E" Offset="0"/>
                        <GradientStop Color="#002C3B9E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-420,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#465A2C86" Offset="0"/>
                        <GradientStop Color="#005A2C86" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="1000" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="200,0,0,-640">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40145A6E" Offset="0"/>
                        <GradientStop Color="#00145A6E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Viewbox Stretch="Fill" Opacity="0.55">
                <Canvas Width="100" Height="100">
                    <Ellipse Canvas.Left="12" Canvas.Top="18" Width="0.12" Height="0.2" Fill="#B3FFFFFF"/>
                    <Ellipse Canvas.Left="34" Canvas.Top="72" Width="0.1" Height="0.16" Fill="#80FFFFFF"/>
                    <Ellipse Canvas.Left="58" Canvas.Top="12" Width="0.15" Height="0.24" Fill="#99FFFFFF"/>
                    <Ellipse Canvas.Left="76" Canvas.Top="44" Width="0.1" Height="0.16" Fill="#73FFFFFF"/>
                    <Ellipse Canvas.Left="88" Canvas.Top="82" Width="0.1" Height="0.16" Fill="#8CFFFFFF"/>
                    <Ellipse Canvas.Left="22" Canvas.Top="92" Width="0.14" Height="0.22" Fill="#66FFFFFF"/>
                    <Ellipse Canvas.Left="66" Canvas.Top="64" Width="0.1" Height="0.16" Fill="#59FFFFFF"/>
                    <Ellipse Canvas.Left="45" Canvas.Top="38" Width="0.1" Height="0.16" Fill="#4DFFFFFF"/>
                    <Ellipse Canvas.Left="93" Canvas.Top="8" Width="0.1" Height="0.16" Fill="#66FFFFFF"/>
                    <Ellipse Canvas.Left="5" Canvas.Top="55" Width="0.1" Height="0.16" Fill="#59FFFFFF"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <ContentControl x:Name="LibraryHost"/>
        <ContentControl x:Name="PlayerHost" Visibility="Collapsed"/>

        <!-- dims the library while a dialog is open -->
        <Border x:Name="Dim" Background="#8C03040A" Visibility="Collapsed"/>

        <!-- toast lives in a popup so it also shows above the video surface -->
        <Popup x:Name="ToastPopup" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
               StaysOpen="True" PopupAnimation="Fade">
            <Border Margin="20" Padding="16,8,8,8" CornerRadius="14" Background="#EE161828" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    Effect="{StaticResource SoftShadow}" TextElement.FontFamily="{StaticResource UiFont}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="16" Foreground="#B3FFFFFF"/>
                    <TextBlock x:Name="ToastText" Margin="12,0,14,0" VerticalAlignment="Center" FontSize="13.5" Foreground="White"
                               MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ToastAction" Style="{StaticResource BtnBase}" Height="32" Background="#24FFFFFF" Foreground="White"
                            FontWeight="Medium" FontSize="13" Click="ToastAction_Click"/>
                    <Button Style="{StaticResource IconBtn}" Width="32" Height="32" Margin="4,0,0,0" Click="ToastClose_Click" ToolTip="Dismiss">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
