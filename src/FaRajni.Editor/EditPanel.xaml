<UserControl x:Class="FaRajni.Editor.EditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="White" FontSize="13.5">
    <Border Padding="16,14,16,16" CornerRadius="20" Background="#D9111320" BorderBrush="#1AFFFFFF" BorderThickness="1">
        <StackPanel>
            <!-- tabs + note + play/close -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#12FFFFFF" CornerRadius="12" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabCut" GroupName="EditTab" Style="{StaticResource SegBtn}" IsChecked="True" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="14"/>
                                <TextBlock Text="Cut clip" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabGif" GroupName="EditTab" Style="{StaticResource SegBtn}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="14"/>
                                <TextBlock Text="GIF" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabAudio" GroupName="EditTab" Style="{StaticResource SegBtn}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="14"/>
                                <TextBlock Text="Audio" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Note" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="#8CFFFFFF" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="34" Height="34" Background="#1AFFFFFF"
                        Foreground="White" ToolTip="Play / pause (Space)" Click="Play_Click" Margin="0,0,4,0">
                    <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="15"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconBtn}" Width="34" Height="34" Foreground="White"
                        ToolTip="Close editor (Esc)" Click="Close_Click">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13"/>
                </Button>
            </Grid>

            <!-- filmstrip track -->
            <Grid x:Name="Track" Height="62" Margin="0,14,0,0" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Track_Down" MouseMove="Track_Move" MouseLeftButtonUp="Track_Up" LostMouseCapture="Track_Lost"
                  SizeChanged="Track_SizeChanged">
                <Border x:Name="FrameClip">
                    <UniformGrid x:Name="Frames" Rows="1"/>
                </Border>
                <Canvas x:Name="RangeLayer" ClipToBounds="False">
                    <Border x:Name="DimLeft" Height="62" Background="#9E0A0C14" CornerRadius="11,0,0,11"/>
                    <Border x:Name="DimRight" Height="62" Background="#9E0A0C14" CornerRadius="0,11,11,0"/>
                    <Border x:Name="SelBox" Height="66" Canvas.Top="-2" BorderThickness="2" BorderBrush="{StaticResource TrimBrush}"
                            CornerRadius="9" IsHitTestVisible="False"/>
                    <Border x:Name="HandleIn" Width="14" Height="66" Canvas.Top="-2" CornerRadius="6" Background="{StaticResource TrimBrush}"
                            Cursor="SizeWE" ToolTip="Drag to set start ([)" MouseLeftButtonDown="HandleIn_Down">
                        <Border Width="2" Height="20" CornerRadius="1" Background="#59000000"/>
                    </Border>
                    <Border x:Name="HandleOut" Width="14" Height="66" Canvas.Top="-2" CornerRadius="6" Background="{StaticResource TrimBrush}"
                            Cursor="SizeWE" ToolTip="Drag to set end (])" MouseLeftButtonDown="HandleOut_Down">
                        <Border Width="2" Height="20" CornerRadius="1" Background="#59000000"/>
                    </Border>
                    <Border x:Name="Playhead" Width="2" Height="78" Canvas.Top="-8" Background="White" CornerRadius="1" IsHitTestVisible="False"/>
                </Canvas>
            </Grid>

            <!-- range read-out + options + export -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="RangeInfo" Orientation="Horizontal">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Start" FontSize="11" Foreground="#73FFFFFF"/>
                        <TextBlock x:Name="InText" Style="{StaticResource Mono}" FontSize="12.5" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="End" FontSize="11" Foreground="#73FFFFFF"/>
                        <TextBlock x:Name="OutText" Style="{StaticResource Mono}" FontSize="12.5" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Length" FontSize="11" Foreground="#73FFFFFF"/>
                        <TextBlock x:Name="LenText" Style="{StaticResource Mono}" FontSize="12.5" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnBase}" Height="32" Padding="10,0" FontSize="12.5" BorderBrush="#24FFFFFF" BorderThickness="1"
                            Foreground="White" Content="Start at playhead" Margin="0,0,8,0" Click="SetIn_Click"/>
                    <Button Style="{StaticResource BtnBase}" Height="32" Padding="10,0" FontSize="12.5" BorderBrush="#24FFFFFF" BorderThickness="1"
                            Foreground="White" Content="End at playhead" Click="SetOut_Click"/>
                </StackPanel>

                <StackPanel x:Name="GifOptions" Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock Text="FPS" FontSize="12" Foreground="#8CFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#12FFFFFF" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Fps" Style="{StaticResource SegBtn}" Height="28" Padding="9,0" Tag="10" Content="10" Checked="Fps_Checked"/>
                            <RadioButton GroupName="Fps" Style="{StaticResource SegBtn}" Height="28" Padding="9,0" Tag="15" Content="15" IsChecked="True" Checked="Fps_Checked"/>
                            <RadioButton GroupName="Fps" Style="{StaticResource SegBtn}" Height="28" Padding="9,0" Tag="24" Content="24" Checked="Fps_Checked"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Width" FontSize="12" Foreground="#8CFFFFFF" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <Border Background="#12FFFFFF" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Width" Style="{StaticResource SegBtn}" Height="28" Padding="9,0" Tag="320" Content="320" Checked="Width_Checked"/>
                            <RadioButton GroupName="Width" Style="{StaticResource SegBtn}" Height="28" Padding="9,0" Tag="480" Content="480" IsChecked="True" Checked="Width_Checked"/>
                            <RadioButton GroupName="Width" Style="{StaticResource SegBtn}" Height="28" Padding="9,0" Tag="720" Content="720" Checked="Width_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="ExportBtn" Grid.Column="3" Style="{StaticResource BtnBase}" Background="{StaticResource TrimBrush}"
                        Foreground="{StaticResource TrimInkBrush}" FontWeight="SemiBold" Padding="16,0" Click="Export_Click">
                    <TextBlock x:Name="ExportText" Text="Save cut"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
